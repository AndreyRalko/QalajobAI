rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isEmployer() {
      return isSignedIn() && userDoc().role == 'employer';
    }

    function isStudent() {
      return isSignedIn() && userDoc().role == 'student';
    }

    function notBanned() {
      return isSignedIn() && userDoc().isBanned != true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /resumes/{userId} {
      allow read: if isOwner(userId) || isEmployer() || isAdmin();
      allow write: if isOwner(userId);
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isOwner(companyId) || isAdmin();
    }

    match /vacancies/{vacancyId} {
      allow read: if true;
      allow create: if isEmployer() && notBanned();
      allow update, delete: if isAdmin() ||
        (isEmployer() && resource.data.employerId == request.auth.uid);
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() ||
        (isSignedIn() && (
          resource.data.studentId == request.auth.uid ||
          resource.data.employerId == request.auth.uid
        ));
      allow create: if isStudent() && notBanned() &&
        request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() ||
        (isEmployer() && resource.data.employerId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
    }

    match /savedJobs/{savedJobId} {
      allow read, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create: if isStudent() && notBanned() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
